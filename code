from flask import Flask, request, jsonify
import requests
import os
from dotenv import load_dotenv
import yt_dlp
import subprocess
import json
from pathlib import Path

load_dotenv()

app = Flask(__name__)

# Your API keys and tokens
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
ASSEMBLYAI_API_KEY = os.getenv("ASSEMBLYAI_API_KEY")
TELEGRAM_USER_ID = os.getenv("TELEGRAM_USER_ID")

# AssemblyAI headers
ASSEMBLYAI_HEADERS = {
    "Authorization": ASSEMBLYAI_API_KEY,
    "Content-Type": "application/json"
}

def send_telegram_message(message):
    """Send status updates to Telegram"""
    url = f"https://api.telegram.org/bot{TELEGRAM_BOT_TOKEN}/sendMessage"
    data = {
        "chat_id": TELEGRAM_USER_ID,
        "text": message
    }
    requests.post(url, json=data)

def download_reel(reel_url):
    """Download Instagram reel video"""
    try:
        send_telegram_message("📥 Downloading reel...")
        
        ydl_opts = {
            'format': 'best',
            'outtmpl': '/tmp/reel.mp4',
            'quiet': False,
        }
        
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.download([reel_url])
        
        return '/tmp/reel.mp4'
    except Exception as e:
        send_telegram_message(f"❌ Download failed: {str(e)}")
        return None

def extract_audio(video_path):
    """Extract audio from video"""
    try:
        send_telegram_message("🔊 Extracting audio...")
        
        audio_path = '/tmp/audio.mp3'
        cmd = [
            'ffmpeg', '-i', video_path, '-q:a', '9', '-n', audio_path
        ]
        subprocess.run(cmd, check=True, capture_output=True)
        
        return audio_path
    except Exception as e:
        send_telegram_message(f"❌ Audio extraction failed: {str(e)}")
        return None

def transcribe_audio(audio_path):
    """Transcribe audio using AssemblyAI"""
    try:
        send_telegram_message("🎙️ Transcribing audio (this may take a minute)...")
        
        # Upload audio file
        with open(audio_path, 'rb') as f:
            response = requests.post(
                "https://api.assemblyai.com/v2/upload",
                headers={"Authorization": ASSEMBLYAI_API_KEY},
                files={"file": f}
            )
        
        audio_url = response.json()['upload_url']
        
        # Submit transcription job
        transcript_request = {
            "audio_url": audio_url,
            "language_code": "en"
        }
        
        response = requests.post(
            "https://api.assemblyai.com/v2/transcript",
            json=transcript_request,
            headers=ASSEMBLYAI_HEADERS
        )
        
        transcript_id = response.json()['id']
        
        # Poll for completion
        while True:
            response = requests.get(
                f"https://api.assemblyai.com/v2/transcript/{transcript_id}",
                headers=ASSEMBLYAI_HEADERS
            )
            
            status = response.json()['status']
            
            if status == 'completed':
                return response.json()['text']
            elif status == 'error':
                send_telegram_message(f"❌ Transcription error: {response.json()['error']}")
                return None
            
            # Wait before polling again
            import time
            time.sleep(3)
    
    except Exception as e:
        send_telegram_message(f"❌ Transcription failed: {str(e)}")
        return None

@app.route('/transcribe', methods=['POST'])
def transcribe():
    """Main endpoint to process reel and return transcript only"""
    try:
        data = request.json
        reel_url = data.get('reel_url')
        
        if not reel_url:
            return jsonify({"error": "No reel_url provided"}), 400
        
        send_telegram_message(f"🚀 Starting transcription for: {reel_url}")
        
        # Step 1: Download reel
        video_path = download_reel(reel_url)
        if not video_path:
            return jsonify({"error": "Failed to download reel"}), 400
        
        # Step 2: Extract audio
        audio_path = extract_audio(video_path)
        if not audio_path:
            return jsonify({"error": "Failed to extract audio"}), 400
        
        # Step 3: Transcribe
        transcript = transcribe_audio(audio_path)
        if not transcript:
            return jsonify({"error": "Failed to transcribe"}), 400
        
        # Cleanup
        os.remove(video_path)
        os.remove(audio_path)
        
        result = {
            "reel_url": reel_url,
            "transcript": transcript,
            "status": "success"
        }
        
        send_telegram_message(f"✅ Transcription complete!")
        
        return jsonify(result), 200
    
    except Exception as e:
        send_telegram_message(f"❌ Error: {str(e)}")
        return jsonify({"error": str(e)}), 500

@app.route('/health', methods=['GET'])
def health():
    return jsonify({"status": "ok"}), 200

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=3000)
